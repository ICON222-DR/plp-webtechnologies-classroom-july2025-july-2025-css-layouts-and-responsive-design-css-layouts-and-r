<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Responsive Layout Example</title>
  <style>
    /* --- Global Styles --- */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      background-color: #f4f4f4;
      color: #333;
    }

    header {
      background: #0077cc;
      color: #fff;
      padding: 20px;
      text-align: center;
    }

    /* --- Navigation using Flexbox --- */
    nav {
      display: flex;
      justify-content: center;
      background: #004c99;
      flex-wrap: wrap;
    }

    nav a {
      color: white;
      padding: 14px 20px;
      text-decoration: none;
      text-transform: uppercase;
    }

    nav a:hover {
      background: #0066cc;
    }

    /* --- Main Layout using CSS Grid --- */
    .container {
      display: grid;
      grid-template-columns: 1fr 3fr 1fr;
      gap: 20px;
      padding: 20px;
      max-width: 1200px;
      margin: auto;
    }

    aside {
      background: #e6e6e6;
      padding: 20px;
      border-radius: 8px;
    }

    main {
      background: #fff;
      padding: 20px;
      border-radius: 8px;
    }

    .cards {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 20px;
    }

    .card {
      background: #e8f0fe;
      flex: 1 1 200px;
      padding: 15px;
      border-radius: 8px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.1);
    }

    footer {
      background: #333;
      color: white;
      text-align: center;
      padding: 15px;
      margin-top: 20px;
    }

    /* --- Responsive Design (Media Queries) --- */
    @media (max-width: 992px) {
      .container {
        grid-template-columns: 1fr 2fr;
      }
      aside:last-child {
        display: none; /* Hide right sidebar on tablets */
      }
    }

    @media (max-width: 600px) {
      nav {
        flex-direction: column;
      }
      .container {
        grid-template-columns: 1fr;
      }
      aside {
        display: none; /* Hide sidebars on small screens */
      }
      .cards {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>
  <header>
    <h1>My Responsive Webpage</h1>
    <p>Using Grid & Flexbox Layouts</p>
  </header>

  <nav>
    <a href="#">Home</a>
    <a href="#">About</a>
    <a href="#">Services</a>
    <a href="#">Contact</a>
  </nav>

  <div class="container">
    <aside>
      <h3>Left Sidebar</h3>
      <p>Some sidebar content goes here.</p>
    </aside>

    <main>
      <h2>Main Content Area</h2>
      <p>This section uses <strong>CSS Grid</strong> for the main layout and <strong>Flexbox</strong> for the cards below.</p>

      <div class="cards">
